# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit secrets.toml to git.

[gsheets]
# Full URL or just the spreadsheet key (the long ID in the URL)
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit"
worksheet = "widget_game"   # created automatically if it doesn't exist; use a fresh one for this design

# Paste the contents of your service-account JSON key file here.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "survey-bot@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
